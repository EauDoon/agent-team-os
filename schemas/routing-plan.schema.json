{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Team routing plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "objective",
    "completion_test",
    "route",
    "delegation_reason",
    "assignments"
  ],
  "properties": {
    "plan_version": {
      "const": "agent-team-plan/v0.1"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "completion_test": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": [
        "solo",
        "team"
      ]
    },
    "delegation_reason": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "output",
          "depends_on",
          "write_resources",
          "brief"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "write_resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "brief": {
            "$ref": "#/$defs/brief"
          }
        }
      }
    }
  },
  "$defs": {
    "brief": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://EauDoon.github.io/agent-team-os/schemas/role-brief.schema.json",
      "title": "Agent Team role brief",
      "description": "The six-field contract for one task-scoped role.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "access_scope",
        "task",
        "evidence",
        "output_contract",
        "stop_condition"
      ],
      "properties": {
        "role_brief_version": {
          "type": "string",
          "const": "agent-team-role-brief/v0.1"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "access_scope": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "output_contract": {
          "type": "string",
          "minLength": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
