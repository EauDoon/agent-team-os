{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "task_id",
    "index_sha256",
    "records"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "brief",
              "connect",
              "plan",
              "evidence",
              "audit",
              "evaluation"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        }
      }
    },
    "receipt_version": {
      "const": "agent-team-packet-receipt/v0.1"
    },
    "index_sha256": {
      "type": "string",
      "minLength": 64
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
