{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "task_id",
    "records",
    "closure"
  ],
  "properties": {
    "packet_version": {
      "const": "agent-team-packet/v0.2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "brief",
              "connect",
              "plan",
              "evidence",
              "audit",
              "evaluation"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_record",
        "evidence_record",
        "target_revision",
        "target_source",
        "required_claims"
      ],
      "properties": {
        "audit_record": {
          "type": "string",
          "minLength": 1
        },
        "evidence_record": {
          "type": "string",
          "minLength": 1
        },
        "target_revision": {
          "type": "string",
          "minLength": 1
        },
        "target_source": {
          "type": "string",
          "minLength": 1
        },
        "required_claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Team closure packet"
}
